      "targets": [{"editorMode": "code", "expr": "topk(50, sum by (ip, mac, device_name) (increase(openwrt_netify_application_bytes_total{job=\"openwrt\",router=\"__ROUTER_LABEL__\",application=~\"$application\"}[$__range])))", "instant": true, "legendFormat": "{{device_name}} | {{ip}} | {{mac}}", "range": false, "refId": "A"}],
