#!/bin/sh

SOCKET=/var/run/netifyd/netifyd.sock
COLLECTOR=/usr/lib/lua/prometheus-collectors/netify.lua
STREAM=/usr/lib/lua/prometheus-netify-stream.lua
STATE=/tmp/prometheus-netify-stream-state.json
FIFO=/tmp/prometheus-netify-stream.$$
socat_pid=
lua_pid=

cleanup() {
  [ -z "$lua_pid" ] || kill "$lua_pid" 2>/dev/null || true
  [ -z "$socat_pid" ] || kill "$socat_pid" 2>/dev/null || true
  [ -z "$lua_pid" ] || wait "$lua_pid" 2>/dev/null || true
  [ -z "$socat_pid" ] || wait "$socat_pid" 2>/dev/null || true
  lua_pid=
  socat_pid=
  rm -f "$FIFO"
}

shutdown() {
  cleanup
  exit 0
}

trap shutdown INT TERM
trap cleanup EXIT
mkfifo "$FIFO"

while true; do
  if [ -S "$SOCKET" ]; then
    socat -u "UNIX-CONNECT:$SOCKET" STDOUT >"$FIFO" 2>/dev/null &
    socat_pid=$!
    lua "$STREAM" "$COLLECTOR" "$STATE" <"$FIFO" &
    lua_pid=$!
    wait "$lua_pid" 2>/dev/null || true
    kill "$socat_pid" 2>/dev/null || true
    wait "$socat_pid" 2>/dev/null || true
    socat_pid=
    lua_pid=
  fi
  sleep 2
done
